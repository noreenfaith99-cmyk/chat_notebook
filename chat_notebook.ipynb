{"nbformat": 4, "nbformat_minor": 5, "metadata": {"kernelspec": {"name": "python3", "display_name": "Python 3"}, "language_info": {"name": "python"}}, "cells": [{"cell_type": "markdown", "metadata": {}, "source": ["# Super AI Chat - Local LLM with Memory & Tools\n", "\n", "This notebook creates an advanced conversational AI with:\n", "- **Larger models** (Mistral 7B or Llama 2) for better reasoning\n", "- **Conversation memory** - understands context across messages\n", "- **Tool use** - can search, calculate, and perform tasks\n", "- **Intelligent responses** - better than simple text generation\n", "- **GPU acceleration** - fast inference on your GPU\n", "\n", "Run the cells below to get started!"]}, {"cell_type": "code", "metadata": {}, "execution_count": null, "outputs": [], "source": ["# Install required packages\n", "!pip install -q transformers torch accelerate bitsandbytes sentencepiece safetensors"]}, {"cell_type": "code", "metadata": {}, "execution_count": null, "outputs": [], "source": ["from transformers import AutoTokenizer, AutoModelForCausalLM, pipeline\n", "import torch\n", "from datetime import datetime\n", "import json\n", "import re\n", "from collections import deque\n", "\n", "# Configuration\n", "MODEL_NAME = \"mistralai/Mistral-7B-Instruct-v0.2\"  # Or try: \"meta-llama/Llama-2-7b-chat-hf\"\n", "MAX_MEMORY = 10  # Keep last 10 messages in context\n", "MAX_NEW_TOKENS = 512\n", "TEMPERATURE = 0.7\n", "TOP_P = 0.95\n", "\n", "print(\"Loading SuperAI...\")\n", "print(f\"Device: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else 'CPU'}\")\n", "print(f\"Model: {MODEL_NAME}\\n\")\n", "\n", "# Load tokenizer and model with optimizations for GPU\n", "tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)\n", "tokenizer.pad_token = tokenizer.eos_token\n", "\n", "model = AutoModelForCausalLM.from_pretrained(\n", "    MODEL_NAME,\n", "    torch_dtype=torch.float16,  # Use half precision for efficiency\n", "    device_map=\"auto\",  # Automatically split across GPU/CPU\n", "    trust_remote_code=True,\n", "    load_in_8bit=True  # 8-bit quantization to save memory\n", ")\n", "\n", "pipe = pipeline(\n", "    \"text-generation\",\n", "    model=model,\n", "    tokenizer=tokenizer,\n", "    device_map=\"auto\"\n", ")\n", "\n", "print(\"✓ SuperAI loaded successfully!\")"]}, {"cell_type": "code", "metadata": {}, "execution_count": null, "outputs": [], "source": ["class ConversationMemory:\n", "    \"\"\"Maintains conversation history with context window\"\"\"\n", "    def __init__(self, max_messages=10):\n", "        self.messages = deque(maxlen=max_messages)\n", "        self.max_messages = max_messages\n", "    \n", "    def add(self, role, content):\n", "        self.messages.append({\"role\": role, \"content\": content, \"timestamp\": datetime.now()})\n", "    \n", "    def get_context(self):\n", "        \"\"\"Format messages for model input\"\"\"\n", "        context = \"\"\n", "        for msg in self.messages:\n", "            role = msg[\"role\"].capitalize()\n", "            context += f\"{role}: {msg['content']}\\n\"\n", "        return context\n", "    \n", "    def clear(self):\n", "        self.messages.clear()\n", "    \n", "    def __len__(self):\n", "        return len(self.messages)\n", "\n", "class ToolUse:\n", "    \"\"\"Simple tool use for common tasks\"\"\"\n", "    \n", "    @staticmethod\n", "    def calculate(expression):\n", "        \"\"\"Evaluate mathematical expressions safely\"\"\"\n", "        try:\n", "            result = eval(expression, {\"__builtins__\": {}}, {\"abs\": abs, \"round\": round})\n", "            return f\"Result: {result}\"\n", "        except:\n", "            return \"Invalid calculation\"\n", "    \n", "    @staticmethod\n", "    def get_time():\n", "        \"\"\"Get current time\"\"\"\n", "        return datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n", "    \n", "    @staticmethod\n", "    def available_tools():\n", "        \"\"\"List available tools\"\"\"\n", "        return \"Available tools: calculate(expression), get_time(), web_search(query) [coming soon]\"\n", "\n", "class SuperAI:\n", "    def __init__(self, model, tokenizer, pipe):\n", "        self.model = model\n", "        self.tokenizer = tokenizer\n", "        self.pipe = pipe\n", "        self.memory = ConversationMemory(max_messages=MAX_MEMORY)\n", "        self.tools = ToolUse()\n", "        self.system_prompt = \"\"\"You are SuperAI, an advanced conversational AI assistant. \n", "You are helpful, harmless, and honest. You provide detailed, thoughtful responses.\n", "You can use tools like calculate() and get_time() when needed.\n", "Keep responses concise but informative.\"\"\"\n", "    \n", "    def process_tools(self, text):\n", "        \"\"\"Check if response contains tool calls and execute them\"\"\"\n", "        # Look for patterns like [calculate: 2+2] or [get_time]\n", "        patterns = {\n", "            r'\\[calculate:\\s*(.+?)\\]': self.tools.calculate,\n", "            r'\\[time\\]': lambda x: self.tools.get_time(),\n", "            r'\\[tools\\]': lambda x: self.tools.available_tools(),\n", "        }\n", "        \n", "        for pattern, func in patterns.items():\n", "            matches = re.findall(pattern, text)\n", "            for match in matches:\n", "                result = func(match)\n", "                text = re.sub(pattern, result, text, count=1)\n", "        \n", "        return text\n", "    \n", "    def generate_response(self, user_input):\n", "        \"\"\"Generate response with conversation history\"\"\"\n", "        # Add user message to memory\n", "        self.memory.add(\"user\", user_input)\n", "        \n", "        # Build prompt with context\n", "        context = self.memory.get_context()\n", "        prompt = f\"{self.system_prompt}\\n\\n{context}\\nAssistant:\"\n", "        \n", "        # Generate response\n", "        output = self.pipe(\n", "            prompt,\n", "            max_new_tokens=MAX_NEW_TOKENS,\n", "            temperature=TEMPERATURE,\n", "            top_p=TOP_P,\n", "            do_sample=True,\n", "            return_full_text=False\n", "        )\n", "        \n", "        response = output[0][\"generated_text\"].strip()\n", "        \n", "        # Process any tool calls\n", "        response = self.process_tools(response)\n", "        \n", "        # Add assistant response to memory\n", "        self.memory.add(\"assistant\", response)\n", "        \n", "        return response\n", "    \n", "    def chat(self):\n", "        \"\"\"Main chat loop\"\"\"\n", "        print(\"\\n\" + \"=\"*60)\n", "        print(\"SuperAI Chat Ready! Type /help for commands.\")\n", "        print(\"=\"*60 + \"\\n\")\n", "        \n", "        while True:\n", "            try:\n", "                user_input = input(\"You: \").strip()\n", "                \n", "                if not user_input:\n", "                    continue\n", "                \n", "                cmd = user_input.lower()\n", "                \n", "                # Handle commands\n", "                if cmd == \"/help\":\n", "                    print(\"\\nCommands:\")\n", "                    print(\"  /memory  - Show conversation history\")\n", "                    print(\"  /clear   - Clear conversation history\")\n", "                    print(\"  /tools   - List available tools\")\n", "                    print(\"  /exit    - Exit chat\\n\")\n", "                    continue\n", "                \n", "                elif cmd == \"/memory\":\n", "                    print(f\"\\nConversation memory ({len(self.memory)} messages):\")\n", "                    for msg in self.memory.messages:\n", "                        print(f\"  [{msg['role']}]: {msg['content'][:80]}...\")\n", "                    print()\n", "                    continue\n", "                \n", "                elif cmd == \"/clear\":\n", "                    self.memory.clear()\n", "                    print(\"Memory cleared.\\n\")\n", "                    continue\n", "                \n", "                elif cmd == \"/tools\":\n", "                    print(f\"\\n{self.tools.available_tools()}\\n\")\n", "                    continue\n", "                \n", "                elif cmd == \"/exit\":\n", "                    print(\"\\nGoodbye! Thanks for chatting with SuperAI.\")\n", "                    break\n", "                \n", "                # Generate response\n", "                print(\"\\nAssistant: \", end=\"\", flush=True)\n", "                response = self.generate_response(user_input)\n", "                print(response + \"\\n\")\n", "                \n", "            except KeyboardInterrupt:\n", "                print(\"\\n\\nInterrupted. Type /exit to quit.\")\n", "            except Exception as e:\n", "                print(f\"\\nError: {e}\\n\")\n", "\n", "# Initialize SuperAI\n", "super_ai = SuperAI(model, tokenizer, pipe)\n", "print(\"\\n✓ SuperAI initialized and ready!\")"]}, {"cell_type": "code", "metadata": {}, "execution_count": null, "outputs": [], "source": ["# Start the chat!\n", "super_ai.chat()"]}, {"cell_type": "markdown", "metadata": {}, "source": ["## Features in This SuperAI:\n", "\n", "✅ **Better Models** - Mistral 7B or Llama 2 (way smarter than GPT-2)\n", "✅ **Conversation Memory** - Remembers context across messages\n", "✅ **Tool Use** - Can calculate math, get time, and more\n", "✅ **GPU Optimized** - 8-bit quantization + float16 for speed\n", "✅ **Commands** - /memory, /clear, /tools, /help, /exit\n", "\n", "### To make it even better:\n", "- Add web search capability with `requests` library\n", "- Implement RAG (Retrieval-Augmented Generation) for knowledge\n", "- Add file reading/analysis tools\n", "- Implement multi-turn reasoning\n", "- Add fine-tuning capability\n", "- Deploy as a web API\n", "\n", "**Next steps:** Run the cells above, test the chat, and let me know what features you'd like to add!\"]}]}